{
  "name": "upec-wipe",
  "version": "1.0.0",
  "description": "UPEC-WIPE (Web Identity Purge Engine): a privacy-first fork of auto-identity-remove that sends opt-out and deletion requests to data brokers through web forms and email, behind a masked alias and a VPN check",
  "main": "watcher.js",
  "bin": {
    "upec-wipe": "./bin/upec-wipe.js"
  },
  "files": [
    "bin/",
    "lib/",
    "dashboard/",
    "watcher.js",
    "setup.js",
    "brokers.js",
    "generic-runner.js",
    "run.sh",
    "config.example.json",
    "data/",
    "README.md"
  ],
  "scripts": {
    "setup": "node setup.js",
    "start": "node watcher.js",
    "run": "bash run.sh",
    "test": "node --require ./test/helpers/egress-off.js --test test/*.test.js dashboard/validate.test.js dashboard/config-status.test.js",
    "upec-wipe": "node bin/upec-wipe.js",
    "review:doctor": "bash scripts/cross-model-preflight.sh",
    "review:cross-model": "bash scripts/cross-model-review.sh"
  },
  "dependencies": {
    "axios": "1.20.0",
    "playwright": "1.60.0"
  },
  "optionalDependencies": {
    "nodemailer": "10.0.16"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": ["privacy", "data-broker", "opt-out", "gdpr", "ccpa", "automation", "playwright"],
  "license": "MIT"
}
